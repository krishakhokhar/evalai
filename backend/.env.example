# Copy to backend/.env and fill in real values. Never commit backend/.env.

# MongoDB. Local: mongodb://127.0.0.1:27017/evalai
# Atlas (SRV):  mongodb+srv://USER:PASS@cluster.xxxx.mongodb.net/evalai?retryWrites=true&w=majority
#   - PASS must be percent-encoded if it contains @ : / ? # etc.
#   - In Atlas > Network Access, allow this machine's IP (or 0.0.0.0/0 for local dev).
#   - If SRV/DNS fails on your network, use the non-SRV string from Atlas:
#       mongodb://host1,host2,host3/evalai?replicaSet=...&tls=true&authSource=admin
MONGO_URI=mongodb://127.0.0.1:27017/evalai

JWT_SECRET=change-this-to-a-long-random-string
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# How long mongoose waits to find a reachable server before erroring + retrying.
DB_TIMEOUT_MS=10000

# Initial admin account. On every boot the backend reconciles this account to
# match ADMIN_EMAIL / ADMIN_PASSWORD (creates it, fixes role, resets password).
ADMIN_EMAIL=admin@evalai.local
ADMIN_PASSWORD=change-this-admin-password
